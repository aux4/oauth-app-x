{
  "scope": "aux4",
  "name": "oauth-app-x",
  "version": "0.0.4",
  "description": "X (Twitter) OAuth provider plugin for the aux4/oauth-app core. Adds the x provider and its /x/* routes.",
  "license": "MIT",
  "tags": [
    "oauth",
    "x",
    "twitter",
    "auth",
    "cloud",
    "plugin"
  ],
  "dependencies": [
    "aux4/oauth-app"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "oauth-app",
      "commands": [
        {
          "name": "x",
          "execute": [
            "profile:oauth-app:x"
          ],
          "help": {
            "text": "X (Twitter) OAuth provider"
          }
        }
      ]
    },
    {
      "name": "oauth-app:x",
      "commands": [
        {
          "name": "authorize-url",
          "execute": [
            "set:base=nvl(brokerPublicUrl, cloudVmUrl)",
            "set:redirectUri=!echo -n ${base}/api/x/callback",
            "set:scopes=${query.scopes}",
            "set:scopes=nvl(scopes, xScopes)",
            "set:state=${query.state}",
            "set:clientId=${xClientId}",
            "if(base==) && echo \"Error: this broker's public URL is not set — provide BROKER_PUBLIC_URL, or deploy on aux4.cloud which injects AUX4_CLOUD_VM_URL\" 1>&2 && exit 1 || if(base!=) && true",
            "if(clientId==) && echo \"Error: x has no client credentials configured\" 1>&2 && exit 1 || true",
            "aux4 oauth authorize-url --provider x --clientId value(clientId) param(redirectUri) param(scopes) param(state) --configFile ${packageDir}/providers.yaml"
          ],
          "help": {
            "text": "Build the X authorization URL (server-side; credentials held by this app)",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query — scopes, state",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body (unused here)",
                "default": "{}"
              },
              {
                "name": "xClientId",
                "text": "X OAuth client id",
                "env": "X_CLIENT_ID",
                "default": ""
              },
              {
                "name": "xClientSecret",
                "text": "X OAuth client secret",
                "env": "X_CLIENT_SECRET",
                "default": ""
              },
              {
                "name": "xScopes",
                "text": "Default scopes when the request omits them; falls back to the bundled default",
                "env": "X_SCOPES",
                "default": ""
              },
              {
                "name": "brokerPublicUrl",
                "text": "This broker's own public base URL (e.g. https://host/oauth-broker/api); the redirect URI is <brokerPublicUrl>/callback and must be registered on the X app",
                "env": "BROKER_PUBLIC_URL",
                "default": ""
              },
              {
                "name": "cloudVmUrl",
                "text": "The machine's own public base URL, injected automatically by aux4.cloud (AUX4_CLOUD_VM_URL). Used when BROKER_PUBLIC_URL is not set, so a hosted broker needs no URL config",
                "env": "AUX4_CLOUD_VM_URL",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "exchange",
          "execute": [
            "set:code=${body.code}",
            "set:codeVerifier=${body.codeVerifier}",
            "set:base=nvl(brokerPublicUrl, cloudVmUrl)",
            "set:redirectUri=!echo -n ${base}/api/x/callback",
            "set:clientId=${xClientId}",
            "set:clientSecret=${xClientSecret}",
            "if(base==) && echo \"Error: this broker's public URL is not set — provide BROKER_PUBLIC_URL, or deploy on aux4.cloud which injects AUX4_CLOUD_VM_URL\" 1>&2 && exit 1 || if(base!=) && true",
            "if(clientId==) && echo \"Error: x has no client credentials configured\" 1>&2 && exit 1 || true",
            "aux4 oauth exchange --provider x --clientId value(clientId) --clientSecret value(clientSecret) param(code) param(codeVerifier) param(redirectUri) --includeTokens true --configFile ${packageDir}/providers.yaml"
          ],
          "help": {
            "text": "Exchange an authorization code for tokens (server-side; credentials held by this app)",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params (unused here)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body — code, codeVerifier (redirectUri is fixed to this broker's callback)",
                "default": "{}"
              },
              {
                "name": "xClientId",
                "text": "X OAuth client id",
                "env": "X_CLIENT_ID",
                "default": ""
              },
              {
                "name": "xClientSecret",
                "text": "X OAuth client secret",
                "env": "X_CLIENT_SECRET",
                "default": ""
              },
              {
                "name": "brokerPublicUrl",
                "text": "This broker's own public base URL; the redirect URI (<brokerPublicUrl>/callback) must match the one used at authorize time",
                "env": "BROKER_PUBLIC_URL",
                "default": ""
              },
              {
                "name": "cloudVmUrl",
                "text": "The machine's own public base URL, injected automatically by aux4.cloud (AUX4_CLOUD_VM_URL). Used when BROKER_PUBLIC_URL is not set, so a hosted broker needs no URL config",
                "env": "AUX4_CLOUD_VM_URL",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "refresh",
          "execute": [
            "set:refreshToken=${body.refreshToken}",
            "set:clientId=${xClientId}",
            "set:clientSecret=${xClientSecret}",
            "if(refreshToken==) && echo \"Error: refreshToken is required\" 1>&2 && exit 1 || true",
            "if(clientId==) && echo \"Error: x has no client credentials configured\" 1>&2 && exit 1 || true",
            "aux4 oauth refresh --provider x --clientId value(clientId) --clientSecret value(clientSecret) param(refreshToken) --configFile ${packageDir}/providers.yaml"
          ],
          "help": {
            "text": "Renew an access token from a refresh token (server-side; credentials held by this app)",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params (unused here)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body — refreshToken",
                "default": "{}"
              },
              {
                "name": "xClientId",
                "text": "X OAuth client id",
                "env": "X_CLIENT_ID",
                "default": ""
              },
              {
                "name": "xClientSecret",
                "text": "X OAuth client secret",
                "env": "X_CLIENT_SECRET",
                "default": ""
              }
            ]
          }
        }
      ]
    }
  ]
}
